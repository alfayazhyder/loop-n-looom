# =========================================================
# LOOP_N_LOOOM — Backend Environment Variables
# =========================================================

# Application
NODE_ENV=development
PORT=5000

# Frontend
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT authentication
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"

# Email
# Use "console" during local development.
# Use "smtp" when real email delivery is configured.
EMAIL_MODE=console
EMAIL_FROM_NAME=LOOP_N_LOOOM
EMAIL_FROM_ADDRESS=noreply@example.com

# SMTP — required only when EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=